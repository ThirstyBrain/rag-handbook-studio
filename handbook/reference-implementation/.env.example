# Copy to .env (git-ignored) and set real values. Never commit .env.
# Passwords are placed inside connection URLs: use URL-safe characters only (letters, digits, - _ .).
# POSTGRES_PASSWORD is the bootstrap superuser (used only to create roles and, in tests, scratch databases).
# RAG_OWNER_PASSWORD is the rag_owner role (runs migrations). RAG_APP_PASSWORD is the rag_app role (the API).
# RAG_WORKER_PASSWORD is the rag_worker role (background worker: job queue access only).
POSTGRES_USER=rag
POSTGRES_DB=rag
POSTGRES_PASSWORD=
RAG_OWNER_PASSWORD=
RAG_APP_PASSWORD=
RAG_WORKER_PASSWORD=
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8000
RAG_ENVIRONMENT=local
RAG_LOG_LEVEL=INFO
